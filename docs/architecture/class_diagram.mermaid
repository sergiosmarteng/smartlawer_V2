classDiagram
    class User {
        +id: UUID
        +username: str
        +email: str
        +hashed_password: str
        +is_active: bool
        +created_at: datetime
        +role: str
        +validate_password(password: str): bool
        +create(username: str, email: str, password: str): User
        +get_by_email(email: str): User
    }
    
    class Document {
        +id: UUID
        +user_id: UUID
        +name: str
        +file_path: str
        +document_type: DocumentType
        +status: ProcessingStatus
        +created_at: datetime
        +updated_at: datetime
        +metadata: Dict
        +get_content(): str
        +set_status(status: ProcessingStatus): void
        +update_metadata(metadata: Dict): void
    }
    
    class PetitionDocument {
        +id: UUID
        +document_id: UUID
        +analysis_id: UUID
        +case_number: str
        +court: str
        +parties: List[str]
        +process_petition(): Analysis
    }
    
    class Template {
        +id: UUID
        +user_id: UUID
        +name: str
        +file_path: str
        +template_type: str
        +created_at: datetime
        +placeholders: List[str]
        +get_content(): str
        +extract_placeholders(): List[str]
    }
    
    class Analysis {
        +id: UUID
        +document_id: UUID
        +summary: str
        +requests: List[str]
        +cited_laws: List[str]
        +evidence: List[str]
        +defense_theses: List[str]
        +process_type: str
        +created_at: datetime
        +to_dict(): Dict
    }
    
    class GeneratedDocument {
        +id: UUID
        +user_id: UUID
        +template_id: UUID
        +analysis_id: UUID
        +file_path: str
        +created_at: datetime
        +generate(template: Template, analysis: Analysis, data: Dict): str
        +export_docx(): str
    }
    
    class DocumentProcessor {
        +process_pdf(file_path: str): str
        +apply_ocr(file_path: str): str
        +extract_text(file_path: str): str
        +chunk_document(text: str): List[str]
    }
    
    class AIService {
        +api_key: str
        +model: str
        +analyze_petition(text: str): Dict
        +generate_defense_content(analysis: Dict, template_info: Dict): Dict
        +optimize_prompt(prompt: str, max_tokens: int): str
    }
    
    class TemplateProcessor {
        +parse_template(file_path: str): Dict
        +extract_placeholders(content: str): List[str]
        +fill_template(template_path: str, data: Dict): str
        +save_document(content: str, output_path: str): void
    }
    
    class DocumentController {
        +upload_document(file: UploadFile, user_id: UUID): Document
        +get_document(doc_id: UUID, user_id: UUID): Document
        +list_documents(user_id: UUID, filters: Dict): List[Document]
        +delete_document(doc_id: UUID, user_id: UUID): bool
    }
    
    class AnalysisController {
        +create_analysis(doc_id: UUID, user_id: UUID): Task
        +get_analysis(analysis_id: UUID, user_id: UUID): Analysis
        +list_analyses(user_id: UUID): List[Analysis]
    }
    
    class TemplateController {
        +upload_template(file: UploadFile, name: str, user_id: UUID): Template
        +get_template(template_id: UUID, user_id: UUID): Template
        +list_templates(user_id: UUID): List[Template]
        +delete_template(template_id: UUID, user_id: UUID): bool
    }
    
    class GenerationController {
        +generate_document(template_id: UUID, analysis_id: UUID, data: Dict, user_id: UUID): Task
        +get_generated_document(gen_doc_id: UUID, user_id: UUID): GeneratedDocument
        +list_generated_documents(user_id: UUID): List[GeneratedDocument]
    }
    
    class Task {
        +id: UUID
        +type: TaskType
        +status: TaskStatus
        +progress: int
        +result_id: UUID
        +error: str
        +created_at: datetime
        +updated_at: datetime
        +update_progress(progress: int): void
        +complete(result_id: UUID): void
        +fail(error: str): void
    }
    
    class TaskQueue {
        +enqueue_task(task_type: TaskType, params: Dict): Task
        +get_task_status(task_id: UUID): TaskStatus
        +process_next_task(): void
    }
    
    class AuthService {
        +create_access_token(data: Dict): str
        +verify_token(token: str): Dict
        +get_current_user(token: str): User
    }
    
    User "1" -- "*" Document: owns
    User "1" -- "*" Template: owns
    User "1" -- "*" GeneratedDocument: owns
    Document <|-- PetitionDocument: extends
    PetitionDocument "1" -- "1" Analysis: produces
    Analysis "1" -- "*" GeneratedDocument: used by
    Template "1" -- "*" GeneratedDocument: used by
    DocumentController -- DocumentProcessor: uses
    AnalysisController -- AIService: uses
    GenerationController -- TemplateProcessor: uses
    AnalysisController -- TaskQueue: enqueues tasks
    GenerationController -- TaskQueue: enqueues tasks