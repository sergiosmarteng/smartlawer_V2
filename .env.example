# ==============================================
# SmartLawer V2 - Environment Variables
# ==============================================
# Copy this file to .env and fill in your actual values.
# Do NOT commit .env to version control.

# ----------------------------------------------
# Clerk Authentication
# ----------------------------------------------

# Your Clerk publishable key (found in Clerk Dashboard > API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Your Clerk secret key (found in Clerk Dashboard > API Keys)
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Clerk route configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ----------------------------------------------
# GitHub Integration
# ----------------------------------------------

# Your GitHub personal access token (generate at https://github.com/settings/tokens)
GITHUB_TOKEN=ghp_your_github_token_here

# GitHub repository owner
GITHUB_OWNER=schinasergio

# GitHub repository name
GITHUB_REPO=smartlawer_V2
