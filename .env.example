# ==============================================
# SmartLawer V2 - Environment Variables
# ==============================================
# Copy this file to .env and fill in your actual values.
# Do NOT commit .env to version control.
# docker-compose.yml reads .env automatically (optional) and every
# variable below has a dev default, so `docker compose up` works
# with no .env at all — minus real AI keys (chat/embeddings stay
# disabled until OPENAI_API_KEY or OPENROUTER_API_KEY is set).

# ----------------------------------------------
# Compose ports / infra
# ----------------------------------------------
API_PORT=8000
DB_PORT=5432
REDIS_PORT=6379
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smartlawer

# Container infra URLs (defaults already point at compose services;
# override only when running the backend outside compose).
DATABASE_URL=postgresql://postgres:postgres@db:5432/smartlawer
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=development
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
SKIP_STARTUP_MIGRATIONS=false

# ----------------------------------------------
# Backend auth (JWT)
# ----------------------------------------------
# REQUIRED in any shared/prod environment. The compose default is an
# insecure dev placeholder — replace it before exposing the stack.
SECRET_KEY=dev-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ----------------------------------------------
# AI provider (chat + embeddings + RAG)
# ----------------------------------------------
# openai: OPENAI_API_KEY (direct OpenAI)
# openrouter: OPENROUTER_API_KEY (multi-provider gateway)
# gemini: GEMINI_API_KEY (Google AI Studio / Vertex) + CHAT_MODEL below.
#   NUNCA cole chaves reais neste arquivo de exemplo (ele é commitado).
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Model used by the openai + gemini providers (openrouter pins its own).
# Gemini 3 Flash: confirme o ID exato em
# https://generativelanguage.googleapis.com/v1beta/models e ajuste aqui.
CHAT_MODEL=gpt-4-turbo
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_VERSION=v1
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# ----------------------------------------------
# RAG pipeline flags
# ----------------------------------------------
DOCLING_ENABLED=false
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_TOP_K=6
RRF_K=60
RERANK_ENABLED=false
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-3

# ----------------------------------------------
# Generated-file history/retention (C2/BL-017)
# ----------------------------------------------
# How many DOCX generations to keep per analysis (files + rows).
GENERATED_KEEP_LATEST=10

# ----------------------------------------------
# Shared jurisprudence corpus (C5/BL-023)
# ----------------------------------------------
# Seed the curated precedent corpus on API boot (idempotent).
PRECEDENTS_AUTO_SEED=true

# ----------------------------------------------
# Frontend (Next.js, runs outside compose via `npm run dev`)
# ----------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
